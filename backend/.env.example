# Gemini API Configuration
# Get your free API key at: https://aistudio.google.com
GOOGLE_API_KEY=AIzaSy_YOUR_API_KEY_HERE

# Server Configuration
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Optional: Video fetching timeouts (in seconds)
VIDEO_FETCH_TIMEOUT=30
METADATA_FETCH_TIMEOUT=30

# Optional: ChromaDB settings
CHROMADB_COLLECTION=video_rag
