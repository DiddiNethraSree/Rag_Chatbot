# Gemini API Configuration (Google Generative AI)
# Get your FREE API key at: https://aistudio.google.com
# Optional here — you can also paste the key in the web UI on each run.
GEMINI_API_KEY=

# LLM model (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-flash-lite-latest

# Server Configuration
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Optional: Video fetching timeouts (in seconds)
VIDEO_FETCH_TIMEOUT=30
METADATA_FETCH_TIMEOUT=30

# Optional: ChromaDB settings
CHROMADB_COLLECTION=video_rag

